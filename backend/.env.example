# Copy to backend/.env for local development. Never commit the real .env file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
API_KEY=your_openrouteservice_api_key

# SQL Server connection using SQL authentication.
DB_HOST=localhost
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Keep certificate verification on
# unless your local development SQL Server uses a self-signed certificate.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECT_TIMEOUT=5
