# Copy to backend/.env for local development. Never commit the real .env file.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4173,http://127.0.0.1:4173
# For local trip-planning tests, use a Google Maps Demo Key from
# https://developers.google.com/maps/demo-key (no billing account required).
# Supports Geocoding API v4, Compute Routes, and Maps JavaScript API.
GOOGLE_MAPS_API_KEY=AIzaSyAfOTycHiBqm50FDgO71rGkpF6pABkJeCo
# Optional for local testing. If blank, the demo key above is used in the browser.
# For billed production use, set a separate, website-restricted browser key.
GOOGLE_MAPS_BROWSER_KEY=
# Set to true when the frontend and backend are served over HTTPS.
AUTH_COOKIE_SECURE=false

# Required for emailed password reset links. Use an SMTP account or app password;
# never put real credentials in this example file. Match the frontend's actual URL.
FRONTEND_PUBLIC_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# DB_AUTH=sql uses DB_USER and DB_PASSWORD. DB_AUTH=windows uses the
# Windows account running FastAPI and needs no username or password.
DB_AUTH=sql
DB_HOST=localhost
# Leave DB_PORT empty when DB_HOST is a named instance such as .\SQLEXPRESS.
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Keep certificate verification on
# unless your local development SQL Server uses a self-signed certificate.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_CONNECT_TIMEOUT=5
